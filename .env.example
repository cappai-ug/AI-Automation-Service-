# Google Sheets Integration - Wählen Sie eine Option:

# Option 1: Google Apps Script (empfohlen)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/d/YOUR_SCRIPT_ID/usercopy

# Option 2: Google Sheets API
GOOGLE_SHEETS_API_KEY=your_api_key_here
SPREADSHEET_ID=your_spreadsheet_id_here

# Google Analytics 4 (GA4) Measurement ID, Format: G-XXXXXXXXXX
# Setzen → GA wird auf jeder Seite geladen (Consent-Mode v2, lädt erst nach
# Akzeptieren von "Analytics" im Cookie-Banner). Leer lassen → kein Tracking.
NEXT_PUBLIC_GA_ID=

# Google Ads Conversion-Tag ID, Format: AW-XXXXXXXXXX
# Setzen → Ads-Tag wird parallel zu GA4 geladen (gleicher gtag.js).
# Aktiviert nur nach Zustimmung zu "Marketing" im Cookie-Banner.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google Ads Conversion-Labels — werden pro Conversion-Aktion in Google Ads
# generiert (Tools → Conversions → Aktion anlegen → Tag-Setup → Label).
# Werden auf /danke?typ=... gefeuert, wenn entsprechende Variable gesetzt ist.
NEXT_PUBLIC_ADS_LABEL_LEAD_MAGNET=
NEXT_PUBLIC_ADS_LABEL_NEWSLETTER=
NEXT_PUBLIC_ADS_LABEL_WAITLIST=
NEXT_PUBLIC_ADS_LABEL_CONTACT=

# Calendly-URL für das "Strategiegespräch buchen"-CTA auf Branchen-Landingpages
# und anderswo. Beispiel: https://calendly.com/niklas-cappai/strategie
# Wenn leer → Fallback auf mailto:hello@optimazed.de.
NEXT_PUBLIC_CALENDLY_URL=

# E-Mail, an die jede Dateneingabe (Waitlist, Newsletter, Lead-Magnet)
# als Notification geschickt wird. Default: info@cappai-ug.de.
NOTIFICATION_EMAIL=

# Optional: Email Service für direktes Mailing
BREVO_API_KEY=your_brevo_key_here
BREVO_LIST_ID=your_list_id_here

# Blog-Automation: Zufallswert für den Cron-Endpoint /api/cron/fetch-feeds
# Wenn gesetzt, muss der Request "Authorization: Bearer $CRON_SECRET" senden.
# Vercel Cron tut das automatisch.
CRON_SECRET=

# Phase 2 — wird benötigt, sobald Claude-Drafts generiert werden sollen.
ANTHROPIC_API_KEY=
