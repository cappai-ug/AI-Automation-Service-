// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Waitlist Model für Lead Capture
model Waitlist {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  company   String?
  useCase   String?
  status    String  @default("new") // new, contacted, demo_sent, customer, rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     String?
  source    String  @default("landing_page")

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// Customer Model für zahlende Kunden
model Customer {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  company   String
  plan      String  // "starter", "professional", "premium"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// RSS-Quelle, die periodisch abgefragt wird, um Themenideen für Blogartikel zu sammeln.
model FeedSource {
  id            String   @id @default(cuid())
  name          String
  url           String   @unique
  enabled       Boolean  @default(true)
  category      String?  // Mapping-Hint: ratgeber | branchen | technologie
  lastFetchedAt DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         FeedItem[]

  @@index([enabled])
}

// Einzelne Items, die aus einer FeedSource extrahiert wurden.
model FeedItem {
  id             String   @id @default(cuid())
  sourceId       String
  source         FeedSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId     String   // RSS guid oder link als Fallback
  title          String
  link           String
  description    String?
  contentSnippet String?
  publishedAt    DateTime?
  fetchedAt      DateTime @default(now())
  processed      Boolean  @default(false)
  relevanceScore Int?     // Haiku-Pre-Scoring 1-10; null = noch nicht bewertet
  scoredAt       DateTime?
  skipReason     String?  // z.B. "keyword:gaming", "score:3", "filter_error"
  drafts         BlogDraft[]

  @@unique([sourceId, externalId])
  @@index([fetchedAt])
  @@index([processed])
  @@index([relevanceScore])
}

// KI-generierter Blogartikel-Entwurf, basierend auf einem FeedItem.
// Status-Workflow: draft → approved → published (oder → rejected).
model BlogDraft {
  id              String   @id @default(cuid())
  sourceItemId    String?
  sourceItem      FeedItem? @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)
  title           String
  slug            String   @unique
  description     String
  category        String   // ratgeber | branchen | technologie
  tags            String[] @default([])
  contentMarkdown String   // MDX-Body, ohne Frontmatter
  relevanceScore  Int      @default(5) // 1-10, Claude-Selbsteinschätzung
  status          String   @default("draft") // draft | approved | published | rejected
  model           String?  // Model-ID, mit dem generiert wurde
  generatedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publishedAt     DateTime?

  @@index([status])
  @@index([category])
  @@index([generatedAt])
}

// DSGVO-konformer Newsletter-Abonnent mit Double-Opt-in.
// Status: pending (nach Anmeldung) → confirmed (nach Click) → unsubscribed (auf Wunsch)
model NewsletterSubscriber {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  source            String   @default("newsletter_form") // newsletter_form | lead_magnet_<name>
  status            String   @default("pending") // pending | confirmed | unsubscribed
  confirmToken      String   @unique
  unsubscribeToken  String   @unique
  consentText       String   // exakter Wortlaut der Einwilligung, für DSGVO-Nachweis
  consentIp         String?  // IP zum Zeitpunkt der Anmeldung
  consentUserAgent  String?
  subscribedAt      DateTime @default(now())
  confirmedAt       DateTime?
  unsubscribedAt    DateTime?
  lastSentAt        DateTime?

  @@index([status])
  @@index([source])
  @@index([subscribedAt])
}
